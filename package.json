{
  "name": "gamehaven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "test": "vitest run",
    "db:setup": "tsx db/setup.ts",
    "electron:compile": "tsc -p electron",
    "electron:start": "npm run electron:compile && electron .",
    "electron:dev": "concurrently -k -n web,app -c magenta,cyan \"next dev\" \"wait-on http://localhost:3000 && npm run electron:start\"",
    "electron:dist": "npm run electron:compile && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.75.0",
    "motion": "^12.43.0",
    "mysql2": "^3.24.6",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "description": "GameHaven — biblioteca de jogos e terceiro espaço social (OsPacientesLLC)",
  "main": "electron/dist/main.js",
  "build": {
    "appId": "pt.gamehaven.desktop",
    "productName": "GameHaven",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**",
      "electron/assets/**",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/logo.png",
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/logo.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/logo.png"
    }
  }
}
